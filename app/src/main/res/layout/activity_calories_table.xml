<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dashbg">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#E91E63"
        android:padding="16dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_media_previous"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Meal"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- MEAL SELECTION -->
    <LinearLayout
        android:id="@+id/mealLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <Button
            android:id="@+id/btnBreakfast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Breakfast"/>

        <Button
            android:id="@+id/btnLunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lunch"/>

        <Button
            android:id="@+id/btnSnacks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Snacks"/>

        <Button
            android:id="@+id/btnDinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dinner"/>
    </LinearLayout>

    <!-- TABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <TableLayout
            android:id="@+id/tableLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:visibility="gone"/>
    </ScrollView>

    <!-- CALCULATOR BUTTON -->

    <Button
        android:id="@+id/btnMealTiming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meal Timing Checker"
        android:layout_margin="10dp"/>

    <Button
        android:id="@+id/btnCalculator"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Calorie Calculator"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_margin="16dp"
        android:backgroundTint="#9C27B0" />

</LinearLayout>
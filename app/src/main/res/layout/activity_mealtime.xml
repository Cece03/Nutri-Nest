<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dashbg"
    android:theme="@style/ThemeOverlay.AppCompat.Light">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#E91E63"
        android:padding="16dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_media_previous"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meal Timer"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meal Time Checker"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="20dp"/>

    <!-- INPUTS -->
    <EditText
        android:id="@+id/etBreakfast"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:hint="Breakfast Time (7-10)"
        android:textColor="#000000"
        android:textColorHint="#000000" />

    <EditText
        android:id="@+id/etLunch"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:hint="Lunch Time (12-3)"
        android:textColor="#000000"
        android:textColorHint="#000000" />

    <EditText
        android:id="@+id/etSnacks"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:hint="Snacks Time (4-6)"
        android:textColor="#000000"
        android:textColorHint="#000000" />

    <EditText
        android:id="@+id/etDinner"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Dinner Time (7-10)"
        android:textColor="#000000"
        android:textColorHint="#000000" />

    <Button
        android:id="@+id/btnCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check Timing"
        android:layout_marginTop="20dp"/>

    <!-- RESULTS -->
    <TextView
        android:id="@+id/resultBreakfast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"/>

    <TextView
        android:id="@+id/resultLunch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"/>

    <TextView
        android:id="@+id/resultSnacks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"/>

    <TextView
        android:id="@+id/resultDinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"/>

</LinearLayout>